cabal-version:      2.4
name:               aventura-ci3661
version:            0.1.0.0
build-type:         Simple

library
  exposed-modules:
      Motor.Tipos
      Motor.Reconocedor
      Motor.Mundo
      Motor.Comandos
      Motor.Nucleo
      Motor.Persistencia
  hs-source-dirs:     .
  build-depends:
      base >= 4.7 && < 5
    , containers
    , directory
    , filepath
  default-language:   Haskell2010
  ghc-options:        -Wall

executable aventura
  main-is:            Main.hs
  hs-source-dirs:     app
  build-depends:
      base >= 4.7 && < 5
    , aventura-ci3661
  default-language:   Haskell2010
  ghc-options:        -Wall

test-suite aventura-test
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            spec.hs
  build-depends:
      base >= 4.7 && < 5
    , containers
    , directory
    , filepath
    , HUnit
    , aventura-ci3661
  default-language:   Haskell2010
  ghc-options:        -Wall -threaded -rtsopts -with-rtsopts=-N
